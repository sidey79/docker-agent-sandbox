# Copy to .env and adjust. The .env file is git-ignored because it holds secrets.

# --- Stack selection -------------------------------------------------------
# dind = agents run against a dedicated rootless Docker daemon (recommended)
# host = agents run against the host Docker daemon via the socket proxy
# Exactly one profile. The dispatcher reads this to decide how an agent
# container reaches the daemon, so a list of two would leave it undecided.
COMPOSE_PROFILES=dind

TZ=Europe/Berlin

# --- Dispatcher API --------------------------------------------------------
# Bearer token n8n must send. Generate with: openssl rand -hex 32
AGENT_API_TOKEN=

# Image used for every agent job. Must be built or pulled beforehand.
AGENT_IMAGE=docker-agent-sandbox/agent:local

# Command run once per job. This is where an agent CLI goes; the task text
# reaches it as AGENT_TASK.md in the workspace. Left empty, a job only brings
# the devcontainer up, which is a useful smoke test.
AGENT_CMD=

# Where AGENT_CMD runs:
#   devcontainer  (default) inside the devcontainer, so it sees the repository's
#                 own toolchain
#   agent         in the agent container itself — for an image with a CLI baked
#                 in, such as the `claude` build target
AGENT_CMD_LOCATION=devcontainer

# Hard limits enforced by the dispatcher, never by the job payload.
AGENT_MAX_CONCURRENCY=2
AGENT_JOB_TIMEOUT_SECONDS=1800
AGENT_MEM_LIMIT=2g
AGENT_CPUS=2
AGENT_PIDS_LIMIT=512

# --- Agent credentials -----------------------------------------------------
# Passed into agent containers by the dispatcher. Never accepted from a request.
# AGENT_CREDENTIAL_ENV names which variables are forwarded; add a name here and
# a matching line to the agent-api service to hand agents another secret.
AGENT_CREDENTIAL_ENV=ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# For the `claude` build target, authenticating Claude Code against a Claude
# subscription instead of an API key. Generate with `claude setup-token` (needs
# a browser once); the token lasts a year and can only make model requests.
# To hand it to agents, name it in AGENT_CREDENTIAL_ENV:
#   AGENT_CREDENTIAL_ENV=CLAUDE_CODE_OAUTH_TOKEN
# A job that edits files also needs --permission-mode acceptEdits in AGENT_CMD;
# without it Claude Code stops at the first edit and still exits 0.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Callbacks to a host with a private CA ---------------------------------
# A callback URL on an internal name often has a certificate from your own CA.
# Point EXTRA_CA_BUNDLE_SOURCE at that CA on the host and set EXTRA_CA_BUNDLE to
# where it lands in the container; the dispatcher adds it to the system trust
# store, so public certificates keep working. Leave both empty otherwise.
#   EXTRA_CA_BUNDLE_SOURCE=/opt/docker/rootca/root-ca.cert.pem
#   EXTRA_CA_BUNDLE=/etc/ssl/extra-ca.pem
EXTRA_CA_BUNDLE_SOURCE=
EXTRA_CA_BUNDLE=

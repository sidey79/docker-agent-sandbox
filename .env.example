# Copy to .env and adjust. The .env file is git-ignored because it holds secrets.

# --- Stack selection -------------------------------------------------------
# dind = agents run against a dedicated rootless Docker daemon (recommended)
# host = agents run against the host Docker daemon via the socket proxy
COMPOSE_PROFILES=dind

TZ=Europe/Berlin

# --- Dispatcher API --------------------------------------------------------
# Bearer token n8n must send. Generate with: openssl rand -hex 32
AGENT_API_TOKEN=

# Image used for every agent job. Must be built or pulled beforehand.
AGENT_IMAGE=docker-agent-sandbox/agent:local

# Hard limits enforced by the dispatcher, never by the job payload.
AGENT_MAX_CONCURRENCY=2
AGENT_JOB_TIMEOUT_SECONDS=1800
AGENT_MEM_LIMIT=2g
AGENT_CPUS=2

# --- Agent credentials -----------------------------------------------------
# Passed into agent containers by the dispatcher. Never accepted from a request.
ANTHROPIC_API_KEY=
